{
    "compilerOptions": {
        "target": "ES2022",
        "module": "CommonJS",
        "moduleResolution": "node",
        "ignoreDeprecations": "6.0",
        "strict": true,
        "esModuleInterop": true,
        "outDir": "dist",
        "types": [
            "node"
        ],
        "skipLibCheck": true
    },
    "include": [
        "*.ts",
        "controller/**/*.ts",
        "model/**/*.ts"
    ],
    "exclude": [
        "node_modules",
        "dist"
    ]
}